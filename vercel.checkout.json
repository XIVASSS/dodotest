{
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @dodo/sdk && npm run build -w @dodo/checkout",
  "outputDirectory": "apps/checkout/dist",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
